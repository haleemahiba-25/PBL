// Function to calculate and execute FCFS scheduling
void calculate_fcfs(struct Process p[], int n) {
    // Step 1: Sort processes by arrival time using bubble sort
    struct Process temp;
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (p[j].arrival_time > p[j+1].arrival_time) {
                temp = p[j];
                p[j] = p[j+1];
                p[j+1] = temp;
            }
        }
    }

    int current_time = 0;

    printf("\n--- FCFS Scheduling Results ---\n");
    printf("PID\tArrival\tBurst\tCompletion\tTurnaround\tWaiting\n");

    for (int i = 0; i < n; i++) {
        // If the CPU is idle before the process arrives
        if (current_time < p[i].arrival_time) {
            current_time = p[i].arrival_time;
        }

        p[i].completion_time = current_time + p[i].burst_time;
        p[i].turnaround_time = p[i].completion_time - p[i].arrival_time;
        p[i].waiting_time = p[i].turnaround_time - p[i].burst_time;

        current_time = p[i].completion_time;

        printf("%d\t%d\t%d\t%d\t\t%d\t\t%d\n", 
            p[i].pid, 
            p[i].arrival_time, 
            p[i].burst_time, 
            p[i].completion_time, 
            p[i].turnaround_time, 
            p[i].waiting_time);
    }
}
