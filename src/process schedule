#include <stdio.h>
#include <stdlib.h>

// Structure to hold individual process attributes
struct Process {
    int pid;              // Process ID
    int arrival_time;     // Arrival time of the process
    int burst_time;       // CPU burst time required
    int remaining_time;   // Remaining time for preemptive algorithms
    int priority;         // Priority level
    int waiting_time;     // Waiting time
    int turnaround_time;  // Turnaround time
    int response_time;    // Response time
    int completion_time;  // Completion time
    int is_started;       // Flag to track if the process has started execution
};

// Function to collect user input manually
void get_user_inputs(struct Process p[], int *n, int *time_quantum) {
    printf("Enter total number of processes: ");
    scanf("%d", n);

    for (int i = 0; i < *n; i++) {
        p[i].pid = i + 1;
        printf("\nProcess %d:\n", p[i].pid);
        
        printf("Arrival Time: ");
        scanf("%d", &p[i].arrival_time);
        
        printf("Burst Time: ");
        scanf("%d", &p[i].burst_time);
        
        printf("Priority: ");
        scanf("%d", &p[i].priority);

        // Initialize helper fields
        p[i].remaining_time = p[i].burst_time;
        p[i].is_started = 0;
        p[i].waiting_time = 0;
        p[i].turnaround_time = 0;
        p[i].response_time = 0;
        p[i].completion_time = 0;
    }

    printf("\nEnter Time Quantum for Round Robin: ");
    scanf("%d", time_quantum);
}

// Function to load a default test case for quick testing
void load_default_testcase(struct Process p[], int *n, int *time_quantum) {
    *n = 4;
    *time_quantum = 2;

    // Hardcoded format: {pid, arrival_time, burst_time, priority}
    int default_data[4][4] = {
        {1, 0, 5, 2},
        {2, 1, 3, 1},
        {3, 2, 8, 3},
        {4, 3, 6, 4}
    };

    for (int i = 0; i < *n; i++) {
        p[i].pid = default_data[i][0];
        p[i].arrival_time = default_data[i][1];
        p[i].burst_time = default_data[i][2];
        p[i].priority = default_data[i][3];
        p[i].remaining_time = p[i].burst_time;
        p[i].is_started = 0;
        p[i].waiting_time = 0;
        p[i].turnaround_time = 0;
        p[i].response_time = 0;
        p[i].completion_time = 0;
    }
    printf("\nDefault test case loaded successfully!\n");
}

// Function to display the entered/loaded process details
void display_processes(struct Process p[], int n, int time_quantum) {
    printf("\n--- Process Input Summary ---\n");
    printf("Time Quantum: %d\n", time_quantum);
    printf("PID\tArrival\tBurst\tPriority\n");
    for (int i = 0; i < n; i++) {
        printf("%d\t%d\t%d\t%d\n", p[i].pid, p[i].arrival_time, p[i].burst_time, p[i].priority);
    }
}

int main() {
    struct Process p[100];
    int n = 0, time_quantum = 0;
    int choice;

    printf("Choose Input Method:\n");
    printf("1. Manual Input\n");
    printf("2. Load Default Test Case\n");
    printf("Enter choice (1 or 2): ");
    scanf("%d", &choice);

    if (choice == 1) {
        get_user_inputs(p, &n, &time_quantum);
    } else {
        load_default_testcase(p, &n, &time_quantum);
    }

    display_processes(p, n, time_quantum);

    return 0;
}
