#include <stdio.h>

typedef struct {
    int id, at, bt, ct, tat, wt, rt;
    int first_exec;
} Process;

int main() {
    int n;
    printf("--- FCFS SCHEDULING ---\n");
    printf("Enter number of processes: ");
    if (scanf("%d", &n) != 1 || n <= 0) return 0;

    Process p[n];
    for (int i = 0; i < n; i++) {
        p[i].id = i + 1;
        p[i].first_exec = -1;
        printf("P%d - Arrival Time & Burst Time: ", p[i].id);
        scanf("%d %d", &p[i].at, &p[i].bt);
    }

    // Sort by arrival time
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (p[j].at > p[j + 1].at) {
                Process temp = p[j];
                p[j] = p[j + 1];
                p[j + 1] = temp;
            }
        }
    }

    int current_time = 0, total_bt = 0;
    float total_wt = 0, total_tat = 0, total_rt = 0;
    int g_pid[100], g_start[100], g_end[100], g_count = 0;

    for (int i = 0; i < n; i++) {
        if (current_time < p[i].at) {
            g_pid[g_count] = 0; // Idle
            g_start[g_count] = current_time;
            current_time = p[i].at;
            g_end[g_count] = current_time;
            g_count++;
        }

        p[i].rt = current_time - p[i].at;
        
        g_pid[g_count] = p[i].id;
        g_start[g_count] = current_time;
        current_time += p[i].bt;
        g_end[g_count] = current_time;
        g_count++;

        p[i].ct = current_time;
        p[i].tat = p[i].ct - p[i].at;
        p[i].wt = p[i].tat - p[i].bt;

        total_bt += p[i].bt;
        total_tat += p[i].tat;
        total_wt += p[i].wt;
        total_rt += p[i].rt;
    }

    printf("\nPID\tAT\tBT\tCT\tTAT\tWT\tRT\n");
    for (int i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\t%d\t%d\n", p[i].id, p[i].at, p[i].bt, p[i].ct, p[i].tat, p[i].wt, p[i].rt);
    }

    printf("\n--- GANTT CHART ---\n+");
    for (int i = 0; i < g_count; i++) printf("-------+");
    printf("\n|");
    for (int i = 0; i < g_count; i++) {
        if (g_pid[i] == 0) printf(" IDLE  |");
        else printf("  P%-2d  |", g_pid[i]);
    }
    printf("\n+");
    for (int i = 0; i < g_count; i++) printf("-------+");
    printf("\n%d", g_start[0]);
    for (int i = 0; i < g_count; i++) printf("%8d", g_end[i]);
    printf("\n");

    printf("\nAverage Turnaround Time: %.2f", total_tat / n);
    printf("\nAverage Waiting Time: %.2f", total_wt / n);
    printf("\nAverage Response Time: %.2f", total_rt / n);
    printf("\nCPU Utilization: %.2f%%\n", ((float)total_bt / current_time) * 100);

    return 0;
}
